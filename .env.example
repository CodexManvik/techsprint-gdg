# ===================
# BACKEND CONFIGURATION
# ===================

# LLM Provider Selection
LLM_PROVIDER=ollama  # Options: ollama, gemini (fallback)

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# PERFORMANCE TUNING (Optimized for RTX 3060, 6GB VRAM):
# - qwen2.5:3b is faster than qwen3.5:4b with similar quality for interviews
# - Reduced token limits cut generation time from ~13s to ~6s per turn
# - Reduced context window (8 vs 14) cuts prompt processing by ~40%
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_SCORING_MODEL=qwen2.5:3b  # Or use same as OLLAMA_MODEL

# Interview Generation Settings (Real-time responsiveness)
INTERVIEW_MAX_NEW_TOKENS=180     # Enough for acknowledgement + feedback + question
INTERVIEW_CONTEXT_MESSAGES=8     # Last 4 user + 4 assistant turns (rolling summary handles older)
INTERVIEW_TEMPERATURE=1.0
INTERVIEW_TOP_P=0.95
INTERVIEW_TOP_K=20
INTERVIEW_MIN_P=0.0
INTERVIEW_PRESENCE_PENALTY=1.5
INTERVIEW_REPETITION_PENALTY=1.0

# Scoring Generation Settings (Background processing)
SCORING_MAX_NEW_TOKENS=150       # Scoring doesn't need long prose
SCORING_CONTEXT_MESSAGES=6
SCORING_TEMPERATURE=1.0
SCORING_TOP_P=0.95
SCORING_TOP_K=20
SCORING_MIN_P=0.0
SCORING_PRESENCE_PENALTY=1.5
SCORING_REPETITION_PENALTY=1.0

LLM_TIMEOUT=5.0
LLM_MAX_RETRIES=2
LLM_STREAM_ENABLED=true

# Redis Configuration (Session Caching)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600  # Session TTL in seconds (1 hour)

# Database
DB_PATH=interview_data.db

# Google Cloud (Fallback for STT/TTS)
GOOGLE_API_KEY=your_actual_api_key_here

# Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440  # 24 hours

# Application
ENV=development  # development | production
DEBUG=true
